@page
@model Week5Project.Pages.IndexModel
@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/site.css" rel="stylesheet" />
    <!-- Bootstrap CSS bağlantısı opsiyonel, zaten site.css içinde stil tanımladığınız için kaldırılabilir -->
    <!-- <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" /> -->
</head>
<body>
    <div class="container">
        <div class="row">
            <!-- Sol Taraf: Form -->
            <div class="col-md-6">
                <h2>Class Information</h2>
                <form method="post">
                    <div class="form-group">
                        <label asp-for="ClassName">Class Name</label>
                        <input asp-for="ClassName" class="form-control" />
                        <span asp-validation-for="ClassName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="StudentCount">Student Count</label>
                        <input asp-for="StudentCount" type="number" class="form-control" />
                        <span asp-validation-for="StudentCount" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description">Description</label>
                        <textarea asp-for="Description" class="form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <button type="submit" asp-page-handler="Add" class="btn btn-primary">Add Class</button>
                </form>
            </div>

            <!-- Sağ Taraf: Veri Tablosu -->
            <div class="col-md-6">
                <h2>Class List</h2>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Class Name</th>
                            <th>Student Count</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var classInfo in IndexModel.ClassInformation)
                        {
                            <tr>
                                <td>@classInfo.Id</td>
                                <td>@classInfo.ClassName</td>
                                <td>@classInfo.StudentCount</td>
                                <td>@classInfo.Description</td>
                                <td>
                                    <!-- Edit and Delete actions -->
                                    <form method="post" asp-page-handler="Edit">
                                        <input type="hidden" name="id" value="@classInfo.Id" />
                                        <button type="submit" class="btn btn-warning">Edit</button>
                                    </form>
                                    <form method="post" asp-page-handler="Delete">
                                        <input type="hidden" name="id" value="@classInfo.Id" />
                                        <button type="submit" class="btn btn-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS (opsiyonel) -->
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
</body>
</html>
