@page
@model Week5Project.Pages.IndexModel
@using Week5Project.Helpers
@{
    ViewData["Title"] = "Class Management";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
</head>
<body>
    <header class="bg-primary text-white p-3">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <h1>Class Management System</h1>
                <form method="get" asp-page="/Logout">
                    <button type="submit" class="btn btn-danger">Logout (@HttpContext.Session.GetString("username"))</button>
                </form>
            </div>
        </div>
    </header>

    <div class="container mt-4">
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <span>Class Information</span>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-page-handler="Add">
                            @Html.AntiForgeryToken()
                            <div class="form-group">
                                <label asp-for="ClassName">Class Name</label>
                                <input asp-for="ClassName" class="form-control" required />
                                <span asp-validation-for="ClassName" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="StudentCount">Student Count</label>
                                <input asp-for="StudentCount" type="number" class="form-control" required min="1" />
                                <span asp-validation-for="StudentCount" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Description">Description</label>
                                <textarea asp-for="Description" class="form-control"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                            <button type="submit" class="btn btn-primary">Add Class</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <span>Class List</span>
                    </div>
                    <div class="card-body">
                        <form method="get" class="mb-3">
                            <div class="form-row">
                                <div class="col">
                                    <input type="text" name="filterClassName" class="form-control" 
                                           placeholder="Filter by class name" value="@Model.ClassTable.FilterClassName" 
                                           oninput="this.form.submit()" />
                                </div>
                            </div>
                        </form>

                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>Class Name</th>
                                        <th>Students</th>
                                        <th>Description</th>
                                        <th>Active</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var classInfo in Model.ClassTable.Classes)
                                    {
                                        <tr data-id="@classInfo.Id">
                                            <td>@classInfo.ClassName</td>
                                            <td>@classInfo.StudentCount</td>
                                            <td>@(classInfo.Description ?? "-")</td>
                                            <td>@(classInfo.IsActive ? "✅" : "❌")</td>
                                            <td class="d-flex">
                                                <button type="button" class="btn btn-warning btn-sm mr-2 edit-btn" 
                                                        data-id="@classInfo.Id"
                                                        data-classname="@classInfo.ClassName"
                                                        data-studentcount="@classInfo.StudentCount"
                                                        data-description="@classInfo.Description"
                                                        data-isactive="@classInfo.IsActive.ToString().ToLower()">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                                <button type="button" class="btn btn-danger btn-sm delete-btn" 
                                                        data-id="@classInfo.Id">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <nav aria-label="Page navigation">
                            <ul class="pagination">
                                @if (Model.ClassTable.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" 
                                           href="?currentPage=@(Model.ClassTable.CurrentPage - 1)&pageSize=@Model.ClassTable.PageSize&filterClassName=@Model.ClassTable.FilterClassName">
                                            Previous
                                        </a>
                                    </li>
                                }
                                @for (int i = 1; i <= Model.ClassTable.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.ClassTable.CurrentPage ? "active" : "")">
                                        <a class="page-link" 
                                           href="?currentPage=@i&pageSize=@Model.ClassTable.PageSize&filterClassName=@Model.ClassTable.FilterClassName">
                                            @i
                                        </a>
                                    </li>
                                }
                                @if (Model.ClassTable.CurrentPage < Model.ClassTable.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" 
                                           href="?currentPage=@(Model.ClassTable.CurrentPage + 1)&pageSize=@Model.ClassTable.PageSize&filterClassName=@Model.ClassTable.FilterClassName">
                                            Next
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>

                        <div class="text-muted">
                            Showing @((Model.ClassTable.CurrentPage - 1) * Model.ClassTable.PageSize + 1) to 
                            @Math.Min(Model.ClassTable.CurrentPage * Model.ClassTable.PageSize, Model.ClassTable.TotalCount) 
                            of @Model.ClassTable.TotalCount entries
                        </div>

                        <button class="btn btn-success mt-3" id="exportBtn">Export Visible Data</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal fade" id="editModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Class</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="editForm" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editId" name="id" />
                    <div class="modal-body">
                        <div class="form-group">
                            <label for="editClassName">Class Name</label>
                            <input type="text" class="form-control" id="editClassName" name="className" required />
                        </div>
                        <div class="form-group">
                            <label for="editStudentCount">Student Count</label>
                            <input type="number" class="form-control" id="editStudentCount" name="studentCount" required min="1" />
                        </div>
                        <div class="form-group">
                            <label for="editDescription">Description</label>
                            <textarea class="form-control" id="editDescription" name="description"></textarea>
                        </div>
                        <div class="form-group form-check">
                            <input type="checkbox" class="form-check-input" id="editIsActive" name="isActive">
                            <label class="form-check-label" for="editIsActive">Active</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- JavaScript Section -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>

    <script>
        $(document).ready(function () {
            // Edit Button
            $(document).on('click', '.edit-btn', function () {
                $('#editId').val($(this).data('id'));
                $('#editClassName').val($(this).data('classname'));
                $('#editStudentCount').val($(this).data('studentcount'));
                $('#editDescription').val($(this).data('description'));
                $('#editIsActive').prop('checked', $(this).data('isactive') === 'true');
                $('#editModal').modal('show');
            });

            // Delete Button
            $(document).on('click', '.delete-btn', function () {
                const id = $(this).data('id');
                const token = $('input[name="__RequestVerificationToken"]').val();

                if (confirm('Are you sure you want to delete this class?')) {
                    $.ajax({
                        url: '?handler=Delete',
                        type: 'POST',
                        data: { id: id },
                        headers: { 'RequestVerificationToken': token },
                        success: function () {
                            window.location.reload();
                        },
                        error: function () {
                            alert('Error deleting class.');
                        }
                    });
                }
            });

            // Edit Form Submit
            $('#editForm').on('submit', function (e) {
                e.preventDefault();
                const formData = $(this).serialize();
                const token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '?handler=Edit',
                    type: 'POST',
                    data: formData,
                    headers: { 'RequestVerificationToken': token },
                    success: function () {
                        $('#editModal').modal('hide');
                        window.location.reload();
                    },
                    error: function () {
                        alert('Error updating class.');
                    }
                });
            });

            // Export Button
            $('#exportBtn').click(function () {
                const filter = '@Model.ClassTable.FilterClassName';
                const currentPage = @Model.ClassTable.CurrentPage;
                const token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '?handler=ExportVisibleData',
                    type: 'GET',
                    data: {
                        filterClassName: filter,
                        currentPage: currentPage,
                        pageSize: @Model.ClassTable.PageSize
                    },
                    headers: { 'RequestVerificationToken': token },
                    success: function (data) {
                        const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
                        const url = URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        a.download = 'exported-classes.json';
                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                    },
                    error: function () {
                        alert('Export failed.');
                    }
                });
            });
        });
    </script>
</body>
</html>