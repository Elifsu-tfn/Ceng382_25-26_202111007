@page
@model Week5Project.Pages.IndexModel
@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
</head>
<body>
    <div class="container">
        <div class="row">
            <!-- Form field on the left side -->
            <div class="col-md-6">
                <div class="form-container">
                    <div class="box-title">
                        <span>Class Information</span>
                    </div>
                    <form method="post">
                        <div class="form-group">
                            <label asp-for="ClassName">Class Name</label>
                            <input asp-for="ClassName" class="form-control" />
                            <span asp-validation-for="ClassName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="StudentCount">Student Count</label>
                            <input asp-for="StudentCount" type="number" class="form-control" />
                            <span asp-validation-for="StudentCount" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Description">Description</label>
                            <textarea asp-for="Description" class="form-control"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <button type="submit" asp-page-handler="Add" class="btn btn-primary">Add Class</button>
                    </form>
                </div>
            </div>

            <!-- Table on the right side with filtering and pagination -->
            <div class="col-md-6">
                <div class="table-container">
                    <div class="box-title">
                        <span>Class List</span>
                    </div>
                    
                    <!-- Filter Form -->
                    <form method="get" class="mb-3">
                        <div class="form-row">
                            <div class="col">
                                <input type="text" name="filterClassName" class="form-control" 
                                       placeholder="Filter by class name" value="@Model.ClassTable.FilterClassName" 
                                       oninput="this.form.submit()" />
                            </div>
                        </div>
                    </form>
                    
                    <!-- Table -->
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Class Name</th>
                                <th>Student Count</th>
                                <th>Description</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var classInfo in Model.ClassTable.Classes)
                            {
                                <tr>
                                    <td>@classInfo.ClassName</td>
                                    <td>@classInfo.StudentCount</td>
                                    <td class="description-cell">@classInfo.Description</td>
                                    <td class="d-flex">
                                        <!-- Edit Button -->
                                        <form method="post" asp-page-handler="Edit" style="display:inline-block;" class="mr-2">
                                            <input type="hidden" name="id" value="@classInfo.Id" />
                                            <button type="submit" class="btn btn-warning btn-sm">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                        </form>

                                        <!-- Delete Button -->
                                        <form method="post" asp-page-handler="Delete" style="display:inline-block;">
                                            <input type="hidden" name="id" value="@classInfo.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    
                    <!-- Pagination -->
                    <nav aria-label="Page navigation">
                        <ul class="pagination">
                            @if (Model.ClassTable.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" 
                                       href="?currentPage=@(Model.ClassTable.CurrentPage - 1)&pageSize=@Model.ClassTable.PageSize&filterClassName=@Model.ClassTable.FilterClassName">
                                        Previous
                                    </a>
                                </li>
                            }
                            
                            @for (int i = 1; i <= Model.ClassTable.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.ClassTable.CurrentPage ? "active" : "")">
                                    <a class="page-link" 
                                       href="?currentPage=@i&pageSize=@Model.ClassTable.PageSize&filterClassName=@Model.ClassTable.FilterClassName">
                                        @i
                                    </a>
                                </li>
                            }
                            
                            @if (Model.ClassTable.CurrentPage < Model.ClassTable.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" 
                                       href="?currentPage=@(Model.ClassTable.CurrentPage + 1)&pageSize=@Model.ClassTable.PageSize&filterClassName=@Model.ClassTable.FilterClassName">
                                        Next
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                    
                    <div class="text-muted">
                        Showing @((Model.ClassTable.CurrentPage - 1) * Model.ClassTable.PageSize + 1) to 
                        @Math.Min(Model.ClassTable.CurrentPage * Model.ClassTable.PageSize, Model.ClassTable.TotalCount) 
                        of @Model.ClassTable.TotalCount entries
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Required extensions for bootstrap -->
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
</body>
</html>
