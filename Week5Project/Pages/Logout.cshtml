@page
@model Week5Project.Pages.LogoutModel
@{
    ViewData["Title"] = "Logout";
}

<div class="container mt-5 text-center">
    <h3>Are you sure you want to logout?</h3>
    <form method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger mt-3">Confirm Logout</button>
    </form>
</div>